#!/bin/sh
# Keep the extension loadable across Ghidra upgrades. Ghidra only loads extensions whose
# extension.properties version matches its own, and compiled .sla files belong to the
# Ghidra release that compiled them, so both are refreshed against the installed Ghidra.
set -e
ghidra=/opt/ghidra
ext=$ghidra/Ghidra/Extensions/xstormy16
[ -d "$ext" ] || exit 0
if [ ! -x "$ghidra/support/sleigh" ]; then
	echo "warning: $ext is installed but there is no Ghidra in $ghidra to load it." >&2
	echo "warning: the ghidra-xstormy16 package only works with Arch's ghidra package." >&2
	exit 0
fi
version=$(sed -n 's/^application.version=//p' "$ghidra/Ghidra/application.properties")
sed -i "s/^version=.*/version=$version/" "$ext/extension.properties"
"$ghidra/support/sleigh" -a "$ext/data/languages" > /dev/null 2>&1
