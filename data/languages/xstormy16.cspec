<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="2"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="2"/>
    <pointer_size value="2"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <long_double_size value="8"/>
    <size_alignment_map>
      <entry size="1" alignment="1"/>
      <entry size="2" alignment="2"/>
      <entry size="4" alignment="2"/>
      <entry size="8" alignment="2"/>
    </size_alignment_map>
  </data_organization>
  <global>
    <range space="code"/>
    <range space="ram"/>
  </global>
  <!-- Stack arguments are not modelled: the decompiler cannot take negative stack
       parameter offsets on an upward-growing stack (as with the stock 8051/PIC specs). -->
  <stackpointer register="sp" space="ram" growth="positive"/>
  <returnaddress>
    <varnode space="stack" offset="-4" size="4"/>
  </returnaddress>
  <default_proto>
    <!-- Observed in Sanyo-compiled firmware: first argument and result in r0. -->
    <prototype name="__sanyo" extrapop="-4" stackshift="-4" strategy="register">
      <input>
        <pentry minsize="1" maxsize="2"><register name="r0"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="r1"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="r2"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="r3"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2"><register name="r0"/></pentry>
      </output>
      <unaffected>
        <register name="sp"/>
        <register name="r8"/>
        <register name="r9"/>
        <register name="r10"/>
        <register name="r11"/>
        <register name="r12"/>
        <register name="r13"/>
      </unaffected>
      <killedbycall>
        <register name="r0"/>
        <register name="r1"/>
        <register name="r2"/>
        <register name="r3"/>
        <register name="r4"/>
        <register name="r5"/>
        <register name="r6"/>
        <register name="r7"/>
      </killedbycall>
    </prototype>
  </default_proto>
  <prototype name="__gcc" extrapop="-4" stackshift="-4" strategy="register">
    <!-- GCC xstormy16 ABI: arguments in r2-r7, result in r2(:r3). -->
    <input>
      <pentry minsize="1" maxsize="2"><register name="r2"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="r3"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="r4"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="r5"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="r6"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="r7"/></pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="2"><register name="r2"/></pentry>
    </output>
    <unaffected>
      <register name="sp"/>
      <register name="r8"/>
      <register name="r9"/>
      <register name="r10"/>
      <register name="r11"/>
      <register name="r12"/>
      <register name="r13"/>
    </unaffected>
  </prototype>
</compiler_spec>
